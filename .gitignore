# Terraform working directory
.terraform/
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable values / secrets
*.tfvars
*.tfvars.json
terraform.tfvars

# Terraform plan files
tfplan
*.tfplan
*plan.txt

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH private keys
*.pem